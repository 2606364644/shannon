# 智谱 GLM 走 OpenAI 兼容接口(coding 通道)。复制为 .env.profiles/glm-openai.env 并填 key。
# 注意: 模型名与 anthropic 接口不同(小写、无 [1m])。
SHANNON_AI_PROVIDER=openai_compatible
SHANNON_OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
SHANNON_OPENAI_API_KEY=your-glm-key
SHANNON_OPENAI_LARGE_MODEL=glm-5.2
SHANNON_OPENAI_MEDIUM_MODEL=glm-5.2
SHANNON_OPENAI_SMALL_MODEL=glm-4.5-air

# per-profile cost 定价（spec 2026-07-09）：anthropic/openai 同源同价，共享 glm.pricing.json。
# 切 profile 即切定价；未设则回落内置 GLM 价表（CNY）。数值已按智谱官网核对。
SHANNON_PRICING_OVERRIDE=.env.profiles/glm.pricing.json

# per-model context window 覆盖(spec 2026-07-10): JSON {"models": {model: ctx_tokens}}。
# chunk token threshold = context × 0.75(留 25% 给 output+system prompt+估算误差)。
# glm-5.2 内置 1M(派生 750K)/glm-4.5-air 128K; 此文件可补充/纠正其他模型的 context。
# 切 profile 即切 context(env_loader override=True 天然 per-profile, 优先级 > .env > 内置)。
# SHANNON_MODEL_CONTEXT_OVERRIDE=.env.profiles/glm.context.json

# hard override(调试/止血用): 直接固定 chunk token threshold, 跳过 context 派生。优先级最高。
# 不设时按 model context 自动派生(推荐)。
# SHANNON_CHUNK_TOKEN_THRESHOLD=
