# 智谱 GLM 走 OpenAI 兼容接口(coding 通道)。复制为 .env.profiles/glm-openai.env 并填 key。
# 注意: 模型名与 anthropic 接口不同(小写、无 [1m])。
SUPERNOVA_AI_PROVIDER=openai_compatible
SUPERNOVA_OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
SUPERNOVA_OPENAI_API_KEY=your-glm-key
SUPERNOVA_OPENAI_LARGE_MODEL=glm-5.2
SUPERNOVA_OPENAI_MEDIUM_MODEL=glm-5.2
SUPERNOVA_OPENAI_SMALL_MODEL=glm-4.5-air

# per-profile cost 定价（spec 2026-07-09）：anthropic/openai 同源同价，共享 glm.pricing.json。
# 切 profile 即切定价；未设则回落内置 GLM 价表（CNY）。数值已按智谱官网核对。
SUPERNOVA_PRICING_OVERRIDE=.env.profiles/glm.pricing.json

# chunk token threshold 按模型 context 自适应(spec 2026-07-10):
# glm-5.2 内置 context=1M -> threshold 自动派生 750K(留 25% 给 output+估算误差);
# glm-4.5-air 内置 128K -> 96K; 未知模型回落 128K。无需手动配即生效。
# SUPERNOVA_MODEL_CONTEXT_OVERRIDE: JSON {"models": {model: ctx_tokens}} 覆盖/补充内置 context 表
#   (经 env_loader 天然 per-profile; 切 profile 即切 context, 优先级 > .env > 内置)。
# SUPERNOVA_CHUNK_TOKEN_THRESHOLD: hard override(调试/止血用), 设了直接固定 threshold 跳过派生。
# 两者默认不设(注释掉)= 走内置表自动派生, 推荐保持。
# SUPERNOVA_MODEL_CONTEXT_OVERRIDE=.env.profiles/glm.context.json
# SUPERNOVA_CHUNK_TOKEN_THRESHOLD=

# chunk 内 suspicious/source call 数上限(跨文件贪心合并, spec 2026-07-10):
# 多个小文件包合并进一个 chunk(减调用次数), 默认 100(kol 631 calls → ~7 chunk)。
# 收紧(如 50)减单 chunk 失败粒度; 放宽增聚合(前提是 token 不超 threshold)。默认不设=100。
# SUPERNOVA_CHUNK_MAX_CALLS=
