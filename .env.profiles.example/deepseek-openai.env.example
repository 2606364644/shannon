# DeepSeek 走 OpenAI 兼容接口。对应 SUPERNOVA_PROFILE=deepseek-openai（openai_compatible 引擎）。
#
# 为何与 deepseek(claude 引擎) 并存:
#   deepseek 的 anthropic 兼容端点忽略 cache_control(官方兼容性表明确),而 Claude Code CLI 的
#   token 累计是 caching-aware 的 → claude 引擎(SUPERNOVA_PROFILE=deepseek)下 usage 被清零、cost 恒 0
#   (详见 memory: claude-engine-cost-getattr-bug-fix)。openai 引擎不经 CLI,直接用 openai-agents
#   SDK 打端点,usage(prompt/completion/reasoning tokens)由端点直给 → cost 能精确计算。
#
# 怎么选:
#   - 要 cost / 要 openai 轨 → SUPERNOVA_PROFILE=deepseek-openai(本文件)
#   - 要 claude 轨(CLI 内置全套工具)扫描,接受 cost=0 → SUPERNOVA_PROFILE=deepseek
SUPERNOVA_AI_PROVIDER=openai_compatible
SUPERNOVA_OPENAI_BASE_URL=https://api.deepseek.com/v1
SUPERNOVA_OPENAI_API_KEY=your-deepseek-key
SUPERNOVA_OPENAI_LARGE_MODEL=deepseek-v4-pro
SUPERNOVA_OPENAI_MEDIUM_MODEL=deepseek-v4-pro
SUPERNOVA_OPENAI_SMALL_MODEL=deepseek-v4-flash

# per-profile cost 定价(spec 2026-07-09): 与 deepseek(claude) 共享 deepseek.pricing.json。
# 切 profile 即切定价;未设则回落内置 GLM 价表(CNY)。数值请按 deepseek 官网核对调整。
SUPERNOVA_PRICING_OVERRIDE=.env.profiles/deepseek.pricing.json

# chunk token threshold 按模型 context 自适应(spec 2026-07-10):
# deepseek-v4-pro/flash 非内置 context 表模型 -> 回落默认 128K -> threshold 96K。
# 如 deepseek 实际支持更大 context,用 SUPERNOVA_MODEL_CONTEXT_OVERRIDE 补充。
# SUPERNOVA_MODEL_CONTEXT_OVERRIDE=.env.profiles/deepseek.context.json
# SUPERNOVA_CHUNK_TOKEN_THRESHOLD=
