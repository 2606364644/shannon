# 智谱 GLM 走 Anthropic 兼容接口。复制为 .env.profiles/glm-anthropic.env 并填 token。
#
# anthropic_api = Claude Code CLI 的"第一方 API 部署模式"(与 bedrock/vertex 同组, 三者
# 都经 claude_agent_sdk 起 CLI 子进程)。凭据 + base_url 经 SDK env 透传给 CLI 子进程,
# 不是 supernova 代码直连; ANTHROPIC_BASE_URL 可指向任意 anthropic 兼容端点(此处=智谱 GLM)。
SUPERNOVA_AI_PROVIDER=anthropic_api
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=your-glm-token
SUPERNOVA_LARGE_MODEL=GLM-5.2[1m]
SUPERNOVA_MEDIUM_MODEL=GLM-5.2[1m]
SUPERNOVA_SMALL_MODEL=GLM-4.5-Air

# per-profile cost 定价（spec 2026-07-09）：anthropic/openai 同源同价，共享 glm.pricing.json。
# 切 profile 即切定价；未设则回落内置 GLM 价表（CNY）。数值已按智谱官网核对。
SUPERNOVA_PRICING_OVERRIDE=.env.profiles/glm.pricing.json

# chunk token threshold 按模型 context 自适应(spec 2026-07-10):
# glm-5.2[1m] 内置 context=1M -> threshold 自动派生 750K(留 25% 给 output+估算误差);
# glm-4.5-air 内置 128K -> 96K; 未知模型回落 128K。无需手动配即生效。
# SUPERNOVA_MODEL_CONTEXT_OVERRIDE: JSON {"models": {model: ctx_tokens}} 覆盖/补充内置 context 表
#   (经 env_loader 天然 per-profile; 切 profile 即切 context, 优先级 > .env > 内置)。
# SUPERNOVA_CHUNK_TOKEN_THRESHOLD: hard override(调试/止血用), 设了直接固定 threshold 跳过派生。
# 两者默认不设(注释掉)= 走内置表自动派生, 推荐保持。
# SUPERNOVA_MODEL_CONTEXT_OVERRIDE=.env.profiles/glm.context.json
# SUPERNOVA_CHUNK_TOKEN_THRESHOLD=

# chunk 内 suspicious/source call 数上限(跨文件贪心合并, spec 2026-07-10):
# 多个小文件包合并进一个 chunk(减调用次数), 默认 100(kol 631 calls → ~7 chunk)。
# 收紧(如 50)减单 chunk 失败粒度; 放宽增聚合(前提是 token 不超 threshold)。默认不设=100。
# SUPERNOVA_CHUNK_MAX_CALLS=

# ── web SSO（富途 OA passport，spec 2026-08-25）─────────────────────────────
# 总开关：开启后登录页出现「使用 OA 账号登录」按钮；authDomain 需在 OA 侧登记。
# ENABLED=1 时 AUTH_DOMAIN 必填（启动 fail-fast）。
# SUPERNOVA_WEB_SSO_ENABLED=0
# SUPERNOVA_WEB_SSO_AUTH_DOMAIN=                     # 本站裸域名，如 codescan.example.com
# SUPERNOVA_WEB_SSO_PUBLIC_BASE_URL=                 # returnUrl 拼接 origin；默认 https://{AUTH_DOMAIN}
# SUPERNOVA_WEB_SSO_PASSPORT_BASE=https://passport.futuoa.com
# SUPERNOVA_WEB_SSO_SESSION_TTL_HOURS=24
