# DeepSeek 走 Anthropic 兼容接口。复制为 .env.profiles/deepseek.env 并填 token。
SHANNON_AI_PROVIDER=anthropic_api
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=your-deepseek-token
SHANNON_LARGE_MODEL=deepseek-v4-pro
SHANNON_MEDIUM_MODEL=deepseek-v4-pro
SHANNON_SMALL_MODEL=deepseek-v4-flash

# per-profile cost 定价（spec 2026-07-09）：指向同目录同名 .pricing.json。切 profile 即切定价；
# 未设则回落内置 GLM 价表（CNY）。数值请按 deepseek 官网核对调整。
SHANNON_PRICING_OVERRIDE=.env.profiles/deepseek.pricing.json

# chunk token threshold 按模型 context 自适应(spec 2026-07-10):
# deepseek-v4-pro 不在内置 context 表 -> 回落默认 128K -> threshold 派生 96K(保守)。
# 如该模型真实 context 更大, 建议经 override 补充以减 chunk 数:
# SHANNON_MODEL_CONTEXT_OVERRIDE: JSON {"models": {model: ctx_tokens}} 覆盖/补充内置 context 表
#   (经 env_loader 天然 per-profile; 切 profile 即切 context)。
# SHANNON_CHUNK_TOKEN_THRESHOLD: hard override(调试/止血用), 设了直接固定 threshold 跳过派生。
# 两者默认不设(注释掉)= 走内置表自动派生。
# SHANNON_MODEL_CONTEXT_OVERRIDE=.env.profiles/deepseek.context.json
# SHANNON_CHUNK_TOKEN_THRESHOLD=
