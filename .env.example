# supernova 环境配置(模板)
# 复制为 .env 并填入共享项 + 当前 SUPERNOVA_PROFILE。
# 引擎/账号配置放在 .env.profiles/<profile>.env(见 .env.profiles.example/)。

# 当前引擎/账号: 改这一行切换, 对应 .env.profiles/<name>.env
SUPERNOVA_PROFILE=glm-anthropic

# 共享配置(引擎无关)
# Web 控制台品牌名(左上角字标 + 浏览器标签页 title);默认 Supernova,改名无需改代码
# SUPERNOVA_WEB_BRAND_NAME=Supernova
SUPERNOVA_BROWSER_ENGINE=playwright            # playwright(默认) | agent-browser
# git URL 扫描模式凭据(表单来源选「git URL」时需要;本地路径模式无需);仅 https + user:token,不支持 ssh
GITLAB_USER=
GITLAB_TOKEN=
# 并发上限:白盒 vuln agents + 黑盒 exploit agents(combined 串行不冲突)
SUPERNOVA_MAX_CONCURRENT=2
# LLM 轨开关: =0 只关 inj/xss/ssrf 的 vuln agent(taint, GitNexus chain_verdict 主干兜底);
# pre-recon/recon/authz/auth 的 LLM 仍跑(GitNexus 做不了 authz Vertical/Context + auth,
# 关了会降安全效果)。默认 1(开, 双轨 OR); token 紧张时设 0 省 inj/xss/ssrf 重型 agent。
# SUPERNOVA_LLM_TRACK_ENABLED=1
# GitNexus 轨单次 LLM 调用(discover_sinks/sources_llm · analyze_taint_llm)超时秒数,
# 超过即降级跳过该函数。默认 60s;大仓 / 慢模型在 .env 调高减少误跳。
# Koa+Sequelize 等大仓治本(2026-07-17):sink/source/taint 三阶段串行累加,推荐 360
# (discover_sources/sinks_llm 文件级取 max(env,120);未设则 effective 120s)。
# SUPERNOVA_LLM_PER_CALL_TIMEOUT=360
# vuln agent attempt 级失败(retryable,Temporal 会重试)是否静默:设 1 则不进终端 UI
# (对齐 TS 终端不渲染 attempt 级);不设则显示黄色 WARNING "将重试 N/M"。
# 用尽/non-retryable 的 ERROR 不受影响(真失败始终可见)。
# SUPERNOVA_SILENT_RETRY=1
# TEMPORAL_ADDRESS=localhost:7233
# SUPERNOVA_DELIVERABLES_SUBDIR=.supernova/deliverables
# SUPERNOVA_WORKER_ROOT=/path/to/worker/root

# Web 认证（P0）
SUPERNOVA_WEB_SESSION_TTL_HOURS=12
SUPERNOVA_WEB_COOKIE_SECURE=1
SUPERNOVA_WEB_USERS_SEED=configs/users.yaml
